set(saved "${TEST_DIR}/speed_persistence_test.dat")
execute_process(COMMAND "${EXE}" --headless --frames 12 --scene slider --speed-ms 16 --settings-file "${saved}" --script "${SCRIPT}" --assets "${ASSETS}" RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 0 OR NOT output MATCHES "speed_ms=19")
 message(FATAL_ERROR "Manual speed application failed: ${output}")
endif()
execute_process(COMMAND "${EXE}" --headless --frames 2 --scene menu --settings-file "${saved}" --assets "${ASSETS}" RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 0 OR NOT output MATCHES "speed_ms=19")
 message(FATAL_ERROR "Saved manual speed did not survive restart: ${output}")
endif()
file(REMOVE "${saved}")
